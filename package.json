{
  "name": "monster-apartment",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src next.config.ts playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:rules": "node --test tests/engine.test.mjs",
    "e2e": "playwright test",
    "check:stable-deps": "node scripts/check-stable-dependencies.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
